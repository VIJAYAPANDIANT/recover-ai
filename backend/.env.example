# Database Connection URL (PostgreSQL)
DATABASE_URL=postgresql://recoverai:recoverai@localhost:5433/recoverai?schema=public

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173

# AI Diagnostic Engine Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Payment Execution Mode: SIMULATION or RAZORPAY_TEST
PAYMENT_EXECUTION_MODE=SIMULATION

# Razorpay Test Mode Configuration (Required only if PAYMENT_EXECUTION_MODE=RAZORPAY_TEST)
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Demo Failure Simulation Flags
RECOVERY_FAILURE_MODE=false
AI_FAILURE_MODE=false
