{
  "name": "recover-ai",
  "version": "1.0.0",
  "description": "RecoverAI - AI-powered Revenue Recovery Platform for Razorpay",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm --prefix backend run test",
    "test:backend": "npm --prefix backend run test",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "seed": "npm --prefix backend run seed"
  },
  "keywords": [
    "revenue-recovery",
    "razorpay",
    "fintech",
    "payments"
  ],
  "author": "RecoverAI Team",
  "license": "MIT"
}
